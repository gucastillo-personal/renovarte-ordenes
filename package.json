{
  "name": "renovarte-ordenes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:leak": "node scripts/check-leak.mjs",
    "gate": "pnpm lint && pnpm typecheck && pnpm test && pnpm check:leak"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1138.0",
    "@aws-sdk/client-lambda": "^3.1138.0",
    "@aws-sdk/client-sesv2": "^3.1138.0",
    "@aws-sdk/client-ssm": "^3.1138.0",
    "@aws-sdk/lib-dynamodb": "^3.1138.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@12.3.4"
